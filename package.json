{
  "name": "nest-sqs",
  "version": "0.1.0",
  "description": "Amazon SQS consumers and producers for NestJS 11 and 12",
  "keywords": [
    "aws",
    "consumer",
    "nestjs",
    "producer",
    "queue",
    "sqs"
  ],
  "homepage": "https://github.com/jaehafe/nest-sqs#readme",
  "bugs": "https://github.com/jaehafe/nest-sqs/issues",
  "license": "MIT",
  "author": "jaehafe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaehafe/nest-sqs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@aws-sdk/client-sqs": "^3.1101.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.723.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}

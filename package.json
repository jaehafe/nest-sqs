{
  "name": "nest-sqs",
  "version": "0.0.0",
  "description": "Amazon SQS consumers and producers for NestJS 11 and 12",
  "keywords": [
    "nestjs",
    "sqs",
    "aws",
    "queue",
    "consumer",
    "producer"
  ],
  "homepage": "https://github.com/jaehafe/nest-sqs#readme",
  "bugs": "https://github.com/jaehafe/nest-sqs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaehafe/nest-sqs.git"
  },
  "license": "MIT",
  "author": "jaehafe",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.723.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@aws-sdk/client-sqs": "^3.1101.0",
    "@nestjs/common": "^12.3.2",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
